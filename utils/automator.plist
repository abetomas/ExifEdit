<!--
Change info.plist to enable opening of image files from Finder 'Open With > Exif Edit'

Open the Info.plist inside your .app bundle 
(right-click app → Show Package Contents → Contents → Info.plist) and replace that entire CFBundleDocumentTypes block with settings below:
-->

<key>CFBundleDocumentTypes</key>
<array>
    <dict>
        <key>CFBundleTypeName</key>
        <string>Image</string>
        <key>CFBundleTypeRole</key>
        <string>Editor</string>
        <key>LSHandlerRank</key>
        <string>Alternate</string>
        <key>LSItemContentTypes</key>
        <array>
            <string>public.jpeg</string>
            <string>public.heic</string>
            <string>public.heif</string>
            <string>public.png</string>
            <string>public.tiff</string>
            <string>com.adobe.raw-image</string>
            <string>com.canon.cr2-raw-image</string>
            <string>com.nikon.nef-raw-image</string>
            <string>com.sony.arw-raw-image</string>
            <string>com.adobe.pdf</string>
            <string>public.mpeg-4</string>
            <string>com.apple.quicktime-movie</string>
        </array>
    </dict>
</array>