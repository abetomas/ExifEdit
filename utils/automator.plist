<!--
Enable Finder 'Open With > ExifEdit'

Note: 
(a) Automator app must have been created previously
(b) see automator.script file

Steps:
(1) Open the Info.plist inside your ExifEdit.app bundle 

    (right-click app → Show Package Contents → Contents → Info.plist) 
    and replace entire CFBundleDocumentTypes block with settings below:

(2) Refresh Finder 

    bash
    /System/Library/Frameworks/CoreServices.framework/Versions/A/Frameworks/LaunchServices.framework/Versions/A/Support/lsregister -f /Applications/ExifEdit.app

    and/or

    bash
    killall Finder

-->

<key>CFBundleDocumentTypes</key>
<array>
    <dict>
        <key>CFBundleTypeName</key>
        <string>Image</string>
        <key>CFBundleTypeRole</key>
        <string>Editor</string>
        <key>LSHandlerRank</key>
        <string>Alternate</string>
        <key>LSItemContentTypes</key>
        <array>
            <string>public.jpeg</string>
            <string>public.heic</string>
            <string>public.heif</string>
            <string>public.png</string>
            <string>public.tiff</string>
            <string>com.adobe.raw-image</string>
            <string>com.canon.cr2-raw-image</string>
            <string>com.nikon.nef-raw-image</string>
            <string>com.sony.arw-raw-image</string>
            <string>com.adobe.pdf</string>
            <string>public.mpeg-4</string>
            <string>com.apple.quicktime-movie</string>
        </array>
    </dict>
</array>
